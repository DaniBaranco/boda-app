---
import { Picture } from 'astro:assets';
import iglesia from '../assets/img/iglesia-torrelaguna.png';
import finca from '../assets/img/wedding-venue.jpg';
import mesas from '../assets/img/mesas_finca.jpg';
import entrada from '../assets/img/entrada_finca.jpeg';
import pareja from '../assets/img/Foto_2025.png';

const slides = [
  { src: pareja, alt: 'Almu y Dani sonriendo juntos', caption: 'Nosotros, 2025' },
  { src: iglesia, alt: 'Fachada de la iglesia de Santa María Magdalena en Torrelaguna', caption: 'La iglesia' },
  { src: entrada, alt: 'Entrada arbolada de la Finca Casa de Oficios', caption: 'Llegada a la finca' },
  { src: finca, alt: 'Jardines de la finca preparados para el cóctel', caption: 'Los jardines' },
  { src: mesas, alt: 'Mesas del banquete decoradas en la finca', caption: 'El banquete' },
];
---

<section id="lugares" class="section" aria-labelledby="lugares-title">
  <div class="section-head reveal">
    <p class="eyebrow">Para ir abriendo boca</p>
    <h2 id="lugares-title">Los lugares</h2>
    <p>Desliza para ver dónde lo celebraremos.</p>
  </div>

  <div class="gallery" data-gallery>
    <ul class="gallery__track" aria-label="Galería de fotos" tabindex="0">
      {
        slides.map((s, i) => (
          <li class="gallery__slide" data-index={i}>
            <figure>
              <Picture
                src={s.src}
                formats={['avif', 'webp']}
    fallbackFormat="jpg"
                widths={[360, 640, 960]}
                sizes="(min-width: 60rem) 40vw, 85vw"
                alt={s.alt}
                loading="lazy"
              />
              <figcaption>{s.caption}</figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
    <div class="gallery__controls">
      <button class="gallery__arrow" type="button" data-dir="-1" aria-label="Foto anterior">‹</button>
      <div class="gallery__dots" role="group" aria-label="Elegir foto">
        {
          slides.map((s, i) => (
            <button
              class="gallery__dot"
              type="button"
              data-go={i}
              aria-label={`Ir a la foto ${i + 1}: ${s.caption}`}
              aria-current={i === 0 ? 'true' : undefined}
            />
          ))
        }
      </div>
      <button class="gallery__arrow" type="button" data-dir="1" aria-label="Foto siguiente">›</button>
    </div>
  </div>
</section>

<style>
  .gallery {
    display: grid;
    gap: var(--space-s);
  }

  .gallery__track {
    list-style: none;
    padding: 0 0 var(--space-xs);
    margin: 0;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 85%;
    gap: var(--space-s);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    border-radius: var(--radius-m);
  }

  .gallery__track::-webkit-scrollbar {
    display: none;
  }

  @media (min-width: 40rem) {
    .gallery__track {
      grid-auto-columns: 55%;
    }
  }

  @media (min-width: 60rem) {
    .gallery__track {
      grid-auto-columns: 40%;
    }
  }

  .gallery__slide {
    scroll-snap-align: center;
  }

  figure {
    position: relative;
    border-radius: var(--radius-m);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--surface-2);
  }

  figure :global(picture) {
    display: block;
    height: 100%;
  }

  figure :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }

  @media (hover: hover) {
    figure:hover :global(img) {
      transform: scale(1.04);
    }
  }

  figcaption {
    position: absolute;
    inset: auto 0 0 0;
    padding: var(--space-l) var(--space-m) var(--space-s);
    color: #fffdf8;
    font: 600 var(--step-1) / 1.2 var(--font-display);
    background: linear-gradient(transparent, rgb(22 18 14 / 0.75));
  }

  .gallery__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
  }

  .gallery__dots {
    display: flex;
  }

  .gallery__dot {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }

  .gallery__dot::before {
    content: '';
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 999px;
    background: var(--line);
    transition:
      width 0.3s var(--ease-out),
      background-color 0.3s;
  }

  .gallery__dot[aria-current='true']::before {
    width: 1.6rem;
    background: var(--gold);
  }

  .gallery__arrow {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--surface);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .gallery__arrow {
      display: grid;
      place-items: center;
    }
  }
</style>

<script>
  for (const gallery of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const track = gallery.querySelector<HTMLElement>('.gallery__track')!;
    const slides = [...track.querySelectorAll<HTMLElement>('.gallery__slide')];
    const dots = [...gallery.querySelectorAll<HTMLButtonElement>('[data-go]')];
    let current = 0;

    const goTo = (i: number) => {
      const idx = (i + slides.length) % slides.length;
      const slide = slides[idx]!;
      track.scrollTo({
        left: slide.offsetLeft - (track.clientWidth - slide.clientWidth) / 2,
        behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
      });
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            current = Number((e.target as HTMLElement).dataset.index);
            dots.forEach((d, i) => d.setAttribute('aria-current', String(i === current)));
          }
        }
      },
      { root: track, threshold: 0.6 },
    );
    slides.forEach((s) => io.observe(s));

    dots.forEach((d) => d.addEventListener('click', () => goTo(Number(d.dataset.go))));
    gallery
      .querySelectorAll<HTMLButtonElement>('[data-dir]')
      .forEach((b) => b.addEventListener('click', () => goTo(current + Number(b.dataset.dir))));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        e.preventDefault();
        goTo(current + (e.key === 'ArrowRight' ? 1 : -1));
      }
    });
  }
</script>
